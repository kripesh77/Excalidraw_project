generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomRole {
  ADMIN
  MEMBER
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  username                 String    @unique
  email                    String    @unique
  password                 String
  refreshToken             String?

  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordChangeAfter      DateTime?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime? @updatedAt

  memberships              RoomMember[]
  shapes    Shape[]
}

model Room {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  createdAt DateTime  @default(now())

  members   RoomMember[]
  shapes    Shape[]
}

model RoomMember {
  userId    String    @db.Uuid
  roomId    Int

  role      RoomRole  @default(MEMBER)

  joinedAt  DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
}



model Shape {
  id        String   @id           // client-generated UUID
  type      String                 // "rect" | "ellipse" | "line" | "free"
  data      Json                   // full shape payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug      String
  room      Room     @relation(fields: [slug], references: [slug], onDelete: Cascade)

  creatorId String   @db.Uuid
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}